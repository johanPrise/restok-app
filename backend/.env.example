# Serveur
PORT=3000
NODE_ENV=development

# PostgreSQL (valeurs par défaut alignées sur docker-compose.yml)
DB_HOST=localhost
DB_PORT=5434
DB_USER=restock
DB_PASSWORD=restock
DB_NAME=restock

# Auth — remplacer par une valeur aléatoire longue (openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
