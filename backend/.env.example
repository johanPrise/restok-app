# Serveur
PORT=3000
NODE_ENV=development

# PostgreSQL (valeurs par défaut alignées sur docker-compose.yml)
DB_HOST=localhost
DB_PORT=5434
DB_USER=restock
DB_PASSWORD=restock
DB_NAME=restock

# Auth — remplacer par une valeur aléatoire longue (openssl rand -hex 32)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Durée d'une session longue, en jours. C'est le refresh token qui la porte :
# l'access token ci-dessus ne vaut qu'une heure, et sans rien derrière, une
# heure était aussi la durée de la session. Repoussée à chaque usage — deux
# mois de silence referment le compte, pas deux mois d'usage.
# REFRESH_TOKEN_DAYS=60

# Push — laisser vide pour viser l'API Expo. À pointer sur un stub en test.
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# CORS — origines autorisées, séparées par des virgules. Vide en développement
# accepte tout ; vide en production refuse tout.
# CORS_ORIGINS=https://restock.example.com

# Email — « mot de passe oublié » n'existe que si un email peut partir.
# Laissé vide en développement, le code s'écrit dans la console du serveur.
# En production, l'absence de ces deux valeurs empêche le démarrage.
# SMTP plutôt que l'API d'un fournisseur : tous en donnent les identifiants.
# MAIL_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
# MAIL_FROM=Restock <bonjour@exemple.fr>

# Plafond de débit — le désactiver n'a de sens que pour les tests e2e, qui
# créent des dizaines de comptes en quelques secondes.
# THROTTLE_DISABLED=true
